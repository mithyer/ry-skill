{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "shared/**/*.ts",
    "ry-herdr-fork/**/*.ts",
    "ry-herdr-clone/**/*.ts",
    "ry-herdr-delegate/**/*.ts"
  ]
}
